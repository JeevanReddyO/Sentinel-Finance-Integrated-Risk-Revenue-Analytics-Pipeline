# Sentinel Finance environment template
# Copy this file to .env and fill in your local values.

DATABASE_URL=postgresql://postgres:<your_password>@localhost:5432/bank_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<your_password>
DB_NAME=bank_db
ALPHA_VANTAGE_API_KEY=<your_alpha_vantage_api_key>
ENVIRONMENT=development
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
